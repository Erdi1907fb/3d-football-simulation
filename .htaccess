Options -Indexes
DirectoryIndex index.php index.html
<FilesMatch "^(config(\.example)?\.php|cron\.php|.*\.(md|test\.mjs|cjs))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.(html|php)|penalty\.html|freekick\.html|build\.php|setup\.php|api\.php)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set CDN-Cache-Control "no-store"
  </FilesMatch>
</IfModule>
# V108: eski sürüm giriş sayfaları tek kanonik sayfaya yönlendirilir.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^next90sim-v[0-9]+\.html$ index.html [R=301,L,QSA]
  RewriteRule ^penalty-v[0-9]+\.html$ penalty.html [R=301,L,QSA]
  RewriteRule ^(VERSION|AGENTS\.md|CLAUDE\.md)$ - [F,L]
  RewriteRule ^(docs|tests|tools)/ - [F,L]
</IfModule>
