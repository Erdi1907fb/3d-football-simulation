Options -Indexes
DirectoryIndex index.php index.html
<FilesMatch "^(config(\.example)?\.php|cron\.php|.*\.(md|test\.mjs))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.(html|php)|penalty(-v99|-v103|-v104|-v105|-v107|-v107|-v107)?\.html|next90sim-v(96|97|98|99|103|104|105|106|107)\.html|build\.php|setup\.php|api\.php)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set CDN-Cache-Control "no-store"
  </FilesMatch>
</IfModule>
